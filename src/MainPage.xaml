<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FontViewer.MainPage"
             x:Name="thisPage"
             Title="Font Viewer">

    <Grid RowDefinitions="Auto,Auto,Auto,*" Padding="10" RowSpacing="8">

        <!-- Font Picker + Load Button -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <Picker x:Name="FontPicker" Title="Selecione a fonte" />
            <Button Grid.Column="1" Text="Carregar" Clicked="OnLoadClicked"
                    Padding="16,0" VerticalOptions="Center" />
        </Grid>

        <!-- Font Size Slider -->
        <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
            <Label Text="Tamanho:" VerticalOptions="Center" />
            <Slider x:Name="FontSizeSlider" Grid.Column="1"
                    Minimum="16" Maximum="80" Value="32"
                    ValueChanged="OnFontSizeChanged" />
            <Label x:Name="FontSizeLabel" Grid.Column="2" Text="32"
                   VerticalOptions="Center" WidthRequest="30" />
        </Grid>

        <!-- Hint -->
        <Label Grid.Row="2" Text="Toque num ícone para copiar o código Unicode"
               FontSize="12" HorizontalOptions="Center"
               TextColor="{StaticResource Gray400}" />

        <!-- Glyphs CollectionView -->
        <CollectionView x:Name="GlyphsCollection" Grid.Row="3"
                        ItemSizingStrategy="MeasureFirstItem">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical" Span="8"
                                 HorizontalItemSpacing="2" VerticalItemSpacing="2" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="2" Padding="4">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer NumberOfTapsRequired="1" Tapped="OnGlyphLongPressed" />
                        </Grid.GestureRecognizers>
                        <Label Text="{Binding Character}"
                               FontFamily="{Binding Source={x:Reference thisPage}, Path=IconFontFamily}"
                               FontSize="{Binding Source={x:Reference thisPage}, Path=FontIconSize}"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center" />
                        <Label Grid.Row="1" Text="{Binding UnicodeCode}"
                               FontSize="9" HorizontalOptions="Center"
                               TextColor="{StaticResource Primary}" />
                        <Label Grid.Row="2" Text="{Binding GlyphName}"
                               IsVisible="{Binding HasGlyphName}"
                               FontSize="7" HorizontalOptions="Center"
                               HorizontalTextAlignment="Center"
                               LineBreakMode="TailTruncation" MaxLines="1"
                               TextColor="{StaticResource Gray400}" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.EmptyView>
                <Label Text="Selecione uma fonte e clique em 'Carregar Ícones'"
                       HorizontalOptions="Center" VerticalOptions="Center"
                       Margin="0,40"
                       TextColor="{StaticResource Gray400}" />
            </CollectionView.EmptyView>
        </CollectionView>

        <!-- Toast -->
        <Border x:Name="ToastBorder" Grid.Row="3"
                IsVisible="False" Opacity="0"
                BackgroundColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray200}}"
                StrokeShape="RoundRectangle 12" Stroke="Transparent"
                Padding="16,10" HorizontalOptions="Center" VerticalOptions="End"
                Margin="0,0,0,30" InputTransparent="True">
            <Label x:Name="ToastLabel" Text="Código copiado!"
                   TextColor="{AppThemeBinding Light=White, Dark={StaticResource Gray900}}"
                   FontSize="14" />
        </Border>

    </Grid>

</ContentPage>
